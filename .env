
# Base directory for all persistent Docker data.
# Replace with the absolute path to your storage directory.
HOME_DIR=/opt

# DuckDNS configuration.
# Example: myvpn -> myvpn.duckdns.org
DUCKDNS_SUBDOMAIN=myvpn
DUCKDNS_TOKEN=replace_with_your_duckdns_token

# Optional Headscale API key for the exporter.
HEADSCALE_API_KEY=replace_with_your_api_key
